# Copy to .env (or run scripts/setup.sh, which fills it in for this machine).

# Nebula is served on http://localhost:NEBULA_PORT
NEBULA_PORT=7878

# Folder Claude Code writes to. Leave empty for ~/.claude.
# If you set CLAUDE_CONFIG_DIR for Claude Code, put the same path here.
CLAUDE_DIR=

# User the container runs as. On Linux it must be your user (id -u / id -g),
# otherwise Nebula can't read your transcripts.
UID=1000
GID=1000
